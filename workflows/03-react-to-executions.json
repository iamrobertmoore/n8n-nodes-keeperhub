{
  "name": "KeeperHub: React to Executions (Trigger)",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "workflowId": "REPLACE_WITH_A_KEEPERHUB_WORKFLOW_ID",
        "event": "any",
        "includeAuditTrail": true
      },
      "id": "c3000000-0000-4000-8000-000000000001",
      "name": "KeeperHub Trigger",
      "type": "n8n-nodes-keeperhub.keeperHubTrigger",
      "typeVersion": 1,
      "position": [
        -260,
        300
      ],
      "credentials": {
        "keeperHubApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "KeeperHub account"
        }
      },
      "notes": "Polls a KeeperHub workflow's executions. The first poll adopts the current state as a baseline rather than replaying history."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "combinator": "or",
          "conditions": [
            {
              "id": "c3-cond-1",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "leftValue": "={{ $json.status }}",
              "rightValue": "failed"
            },
            {
              "id": "c3-cond-2",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "leftValue": "={{ $json.status }}",
              "rightValue": "error"
            }
          ]
        },
        "options": {}
      },
      "id": "c3000000-0000-4000-8000-000000000002",
      "name": "Did it fail?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -20,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Something reverted. In a real deployment this is where you page someone,\n// open a ticket, or trip a circuit breaker. The audit trail is already here.\nreturn $input.all().map(item => ({\n  json: {\n    alert: 'KeeperHub execution failed',\n    executionId: item.json.executionId ?? item.json.id,\n    status: item.json.status,\n    reason: item.json.error ?? 'no reason reported',\n    at: item.json.completedAt ?? item.json.createdAt\n  }\n}));"
      },
      "id": "c3000000-0000-4000-8000-000000000003",
      "name": "Raise an alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// Landed cleanly. Record the receipt, transaction, real gas cost, timing.\nreturn $input.all().map(item => ({\n  json: {\n    executionId: item.json.executionId ?? item.json.id,\n    transactionLink: item.json.transactionLink,\n    gasUsedUnits: item.json.gasUsedUnits,\n    effectiveGasPriceWei: item.json.effectiveGasPriceWei,\n    gasCostWei: item.json.gasCostWei,\n    completedAt: item.json.completedAt\n  }\n}));"
      },
      "id": "c3000000-0000-4000-8000-000000000004",
      "name": "Log the receipt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        400
      ]
    }
  ],
  "connections": {
    "KeeperHub Trigger": {
      "main": [
        [
          {
            "node": "Did it fail?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Did it fail?": {
      "main": [
        [
          {
            "node": "Raise an alert",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log the receipt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  }
}